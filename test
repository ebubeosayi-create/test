import random


def play_game():
  secret_number = random.randint(1, 50)
  max_attempts = 5
  print("I picked a number between 1 and 50.")
  print("You have 5 attempts to guess it.")

  for attempt in range(1, max_attempts + 1):
    hearts = "❤️" * (max_attempts - attempt + 1)
    print(f"\nLives remaining: {hearts}")

    try:
      guess = int(input(f"Attempt {attempt}: Enter your guess: "))
    except ValueError:
      print("Please enter a valid number.")
      continue

    if guess == secret_number:
      print(f"You win! You found the number {secret_number}!")
      return

    # Give hints based on how close the guess is
    difference = abs(guess - secret_number)
    if difference <= 3:
      print("🔥 Super close! You are burning up!")
    elif difference <= 10:
      print("warm! You are within 10 numbers.")
    else:
      print("cold! You are far away.")

    if guess < secret_number:
      print("Hint: Go higher.")
    else:
      print("Hint: Go lower.")

  print(f"\nGame over! The secret number was {secret_number}.")


play_game()
